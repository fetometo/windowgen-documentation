msgstr "Size"

#: (2)/Documentation/windowgen-documentation-4.0/docs/source/parameters.rst:46
#: DESKTOP-HETTM96/WindowGen
msgid "Width and height of the window."
msgstr "Larghezza e altezza della finestra."

